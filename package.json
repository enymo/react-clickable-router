{
  "name": "@enymo/react-clickable-router",
  "version": "4.0.0",
  "description": "Simple React Component providing a unified API for working with Buttons, Anchors and React Router Links.",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "/dist"
  ],
  "tsdown": {
    "entry": [
      "src/js/index.tsx"
    ],
    "format": [
      "esm",
      "cjs"
    ],
    "dts": true
  },
  "scripts": {
    "build": "tsdown"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enymo/react-clickable-router.git"
  },
  "author": "enymo GmbH",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.0.28",
    "postcss": "^8.4.17",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "classnames": "^2.3.2",
    "tsdown": "^0.22.14"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-router": "^8.3.0"
  },
  "allowScripts": {
    "esbuild@0.17.19": true
  }
}
